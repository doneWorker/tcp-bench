{
  "title": "Service Stats",
  "schemaVersion": 39,
  "editable": true,
  "time": { "from": "now-5m", "to": "now" },
  "refresh": "5s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 6,
      "type": "timeseries",
      "title": "CPU Usage",
      "transparent": true,
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "legendFormat": "{{job}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(process_cpu_seconds_total{job=~\"std|gnet\"}[5s])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "fillOpacity": 27, "spanNulls": true }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory usage (Resident)",
      "transparent": true,
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "legendFormat": "{{job}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "process_resident_memory_bytes{job=~\"std|gnet\"}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "decbytes", "custom": { "fillOpacity": 27 } },
        "overrides": []
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Goroutines",
      "transparent": true,
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "legendFormat": "{{job}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "go_goroutines{job=~\"std|gnet\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 42, "lineInterpolation": "smooth" }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Go Threads",
      "transparent": true,
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "legendFormat": "{{job}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "go_threads{job=~\"std|gnet\"}"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 25 } },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "TCP Active connections",
      "transparent": true,
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "legendFormat": "{{job}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "tcp_active_connections{job=~\"std|gnet\"}"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 25 } },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Total packets processed",
      "transparent": true,
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "legendFormat": "{{job}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "tcp_packets_processed_total{job=~\"std|gnet\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "custom": {
            "fillOpacity": 22,
            "spanNulls": true,
            "lineInterpolation": "smooth"
          }
        },
        "overrides": []
      }
    }
  ]
}
